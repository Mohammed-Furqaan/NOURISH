# =========================================================================
# IDEs and Editors
# =========================================================================
# Eclipse (Dynamic Web Project settings)
# Note: Since this project relies on Eclipse configurations (.project, .classpath, .settings) 
# and does not use Maven/Gradle, we've kept them tracked. However, we ignore metadata 
# and temporary files.
.metadata/
.recommenders/
tmp/
*.tmp
*.bak
*.swp
*~
.loadpath

# If you decide to ignore Eclipse project config later, uncomment the following:
# .classpath
# .project
# .settings/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# VS Code
.vscode/

# =========================================================================
